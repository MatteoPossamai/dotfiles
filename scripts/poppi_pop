#!/usr/bin/env bash
# Run a CPU-pinned job and send its result to Telegram.
set -uo pipefail

usage() {
  cat <<'EOF'
Usage: poppi_pop --cpu N -- command [arguments...]
       poppi_pop --cpu N --pid PID [--log FILE]

CPU numbers start at 0. Output stays visible in your terminal.
Requests nice -20; falls back with a warning if permission is denied.
Run sudo -v first to allow priority elevation without running the job as root.
Telegram gets the exit code, elapsed time and last 10 stdout lines.
Long output is shortened to fit one Telegram message.
Send /start to your bot once; the first run discovers its sole private chat.

PID mode watches an existing process and pins its threads (not existing child
processes). Its exit code is unknown; elapsed time starts when attached.
Stdout is read only when it is a regular file, or from --log FILE.
Ctrl+C stops watching without stopping the existing process.

Private files: ${XDG_CONFIG_HOME:-~/.config}/poppi_pop/{bot-token,chat-id}
EOF
}

die() { printf 'poppi_pop: %s\n' "$*" >&2; exit 2; }

cpu= pid= log_file=
while (( $# )); do
  case $1 in
    --cpu|--pid|--log)
      (( $# >= 2 )) || die "Missing value for $1."
      case $1 in
        --cpu) cpu=$2 ;;
        --pid) pid=$2 ;;
        --log) log_file=$2 ;;
      esac
      shift 2 ;;
    --) shift; break ;;
    --help|-h) usage; exit 0 ;;
    *) die "Unknown option: $1. Use -- before your command." ;;
  esac
done
[[ $cpu =~ ^[0-9]+$ ]] || die 'Specify a CPU with --cpu N.'
if [[ -n $pid ]]; then
  [[ $pid =~ ^[1-9][0-9]*$ && $# == 0 ]] || die 'Use --pid with a positive PID and no command.'
  [[ $pid != "$$" && $pid != "$PPID" ]] || die 'Cannot watch this wrapper or its parent shell.'
else
  (( $# > 0 )) || die 'Specify a command or --pid PID.'
  [[ -z $log_file ]] || die '--log is only available with --pid.'
fi

for dependency in curl jq taskset renice tail tee mktemp mkfifo; do
  command -v "$dependency" >/dev/null || die "Missing command: $dependency"
done
taskset -c "$cpu" true 2>/dev/null || die "CPU $cpu is unavailable."

# The start time distinguishes this process from a later reuse of its PID.
same_process() {
  local stat rest
  local -a fields
  stat=$(<"/proc/$pid/stat") || return 1
  rest=${stat##*) }
  read -ra fields <<< "$rest"
  [[ ${fields[19]:-} == "$process_start" && ${fields[0]:-Z} != [ZX] ]]
}

log_fd= output_note=
started=$SECONDS
if [[ -n $pid ]]; then
  command -v pidwait >/dev/null || die 'PID mode requires pidwait (procps-ng).'
  proc_stat=$(<"/proc/$pid/stat") 2>/dev/null || die "PID $pid is unavailable."
  proc_rest=${proc_stat##*) }
  read -ra proc_fields <<< "$proc_rest"
  process_start=${proc_fields[19]:-}
  same_process 2>/dev/null || die "PID $pid is no longer running."
  mapfile -d '' -t command_args < "/proc/$pid/cmdline" || die 'Cannot read process command.'
  printf -v command_text '%q ' "${command_args[@]}"
  command_text="PID $pid: $command_text"
  if [[ -n $log_file ]]; then
    [[ -f $log_file && -r $log_file ]] || die '--log must name a readable regular file.'
    exec {log_fd}< "$log_file" || die 'Cannot open log file.'
  elif [[ -f /proc/$pid/fd/1 && -r /proc/$pid/fd/1 ]]; then
    exec {log_fd}< "/proc/$pid/fd/1" || die 'Cannot open process stdout file.'
  else
    output_note='(stdout unavailable: process output is not a readable regular file; use --log FILE if a log exists)'
    printf 'poppi_pop: Stdout is unavailable; notification will contain completion details only.\n' >&2
  fi
fi

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/poppi_pop
[[ -r $config_dir/bot-token ]] ||
  die "Save bot-token in $config_dir first (chmod 600)."
token=$(<"$config_dir/bot-token")
[[ $token =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]] || die 'Invalid bot-token file.'

# Pass the authenticated URL over stdin so the token stays out of process args.
telegram() {
  local method=$1
  shift
  printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$token" "$method" |
    curl --config - --silent --fail --connect-timeout 10 --max-time 30 "$@"
}

umask 077
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/poppi_pop.XXXXXXXX") || die 'Cannot create temporary directory.'
trap 'rm -rf -- "$work_dir"' EXIT
if [[ ! -s $config_dir/chat-id ]]; then
  telegram getUpdates --data-urlencode 'timeout=0' --output "$work_dir/updates" ||
    die 'Cannot discover Telegram chat. Check network or set chat-id manually.'
  chat_id=$(jq -er '[.result[]? | .message.chat? | select(.type == "private") | .id] |
    unique | if length == 1 then .[0] else empty end' "$work_dir/updates") ||
    die "Send /start to your bot and retry. For multiple chats, save the destination in $config_dir/chat-id."
  printf '%s\n' "$chat_id" > "$config_dir/chat-id" || die 'Cannot save chat-id.'
fi
chat_id=$(<"$config_dir/chat-id")
[[ $chat_id =~ ^-?[0-9]+$ || $chat_id =~ ^@[A-Za-z0-9_]+$ ]] || die 'Invalid chat-id file.'
raise_priority() {
  # Change scheduling priority only; commands always run as the original user.
  if ! renice --priority -20 -p "$@" >/dev/null 2>&1; then
    if ! command -v sudo >/dev/null || ! sudo -n renice --priority -20 -p "$@" >/dev/null 2>&1; then
      printf 'poppi_pop: Cannot set nice -20 for all tasks; retaining available priorities. Run sudo -v first to enable it.\n' >&2
    fi
  fi
}

if [[ -n $pid ]]; then
  trap 'exit 130' INT
  if same_process 2>/dev/null; then
    taskset -apc "$cpu" "$pid" >/dev/null 2>&1 || {
      if same_process 2>/dev/null; then die "Cannot pin PID $pid; check permissions."; fi
    }
    thread_ids=()
    for thread in /proc/"$pid"/task/[0-9]*; do
      [[ -d $thread ]] && thread_ids+=("${thread##*/}")
    done
    if (( ${#thread_ids[@]} )); then raise_priority "${thread_ids[@]}"; fi
    printf 'poppi_pop: Watching PID %s on CPU %s.\n' "$pid" "$cpu" >&2
    if same_process 2>/dev/null && ! pidwait -p "$pid"; then
      if same_process 2>/dev/null; then die "Cannot wait for PID $pid."; fi
    fi
  fi
  if [[ -n $log_fd ]]; then
    tail -n 10 <&"$log_fd" > "$work_dir/stdout" || die 'Cannot read final log lines.'
    exec {log_fd}<&-
  else
    printf '%s\n' "$output_note" > "$work_dir/stdout"
  fi
  job_status=unknown
  return_status=0
  state='Process ended (success/failure unknown)'
  time_label='Watched'
else
  raise_priority "$$"
  printf -v command_text '%q ' "$@"
  started=$SECONDS
  mkfifo "$work_dir/stdout.pipe" || die 'Cannot create output pipe.'
  # Keep only ten lines on disk, even for jobs with a large amount of output.
  tail -n 10 < "$work_dir/stdout.pipe" > "$work_dir/stdout" &
  tail_pid=$!
  # Let Ctrl+C interrupt the foreground job, then report its exit code.
  trap ':' INT
  taskset -c "$cpu" "$@" | tee "$work_dir/stdout.pipe"
  job_status=${PIPESTATUS[0]}
  wait "$tail_pid" || printf 'poppi_pop: Could not capture all stdout.\n' >&2
  return_status=$job_status
  if (( job_status == 0 )); then state=Finished; else state=Failed; fi
  time_label=Time
fi
elapsed=$((SECONDS - started))

printf -v header 'poppi_pop: %s\nHost: %s\nCommand: %.500s\nCPU: %s | Exit: %s | %s: %ss' \
  "$state" "${HOSTNAME:-unknown}" "$command_text" "$cpu" "$job_status" "$time_label" "$elapsed"
# Telegram accepts 4096 characters. Leave room for the header and shorten only
# oversized output; ordinary jobs retain their complete last ten lines.
jq -nr --arg header "$header" --rawfile output "$work_dir/stdout" \
  '($header[:900]) + "\n\nLast 10 stdout lines:\n" +
   (if $output == "" then "(no stdout)"
    elif ($output | length) > 3000 then "[truncated]\n" + $output[-3000:]
    else $output end)' > "$work_dir/message"

if telegram sendMessage \
      --data-urlencode "chat_id=$chat_id" \
      --data-urlencode "text@$work_dir/message" \
      --output "$work_dir/response" &&
    jq -e '.ok == true' "$work_dir/response" >/dev/null 2>&1; then
  printf 'poppi_pop: Telegram notified (exit %s).\n' "$job_status" >&2
else
  printf 'poppi_pop: Telegram delivery failed; job exit code was %s. Check network and private config.\n' "$job_status" >&2
fi
exit "$return_status"
